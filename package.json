{
  "name": "minimalist-word",
  "version": "1.0.0",
  "description": "Mac Stili Minimalist Word Editörü",
  "main": "main.js",
  "author": "Ders",
  "scripts": {
    "start": "electron .",
    "build:linux": "electron-builder --linux AppImage",
    "build:mac": "electron-builder --mac dmg"
  },
  "build": {
    "appId": "com.ders.minimalistword",
    "productName": "MinimalistWord",
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Office"
    },
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.productivity",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "notarize": false
    },
    "dmg": {
      "sign": false
    }
  },
  "dependencies": {
    "html-to-docx": "^1.8.0",
    "mammoth": "^1.6.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3"
  },
  "overrides": {
    "@noble/hashes": "1.3.3"
  }
}
